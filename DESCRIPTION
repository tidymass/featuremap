Package: featuremap
Title: Network-Based Functional Module Identification in Metabolomics
Version: 0.0.0.9000
Authors@R: c(
    person("Yuting", "Wang",
           email = "ytwangzero@outlook.com",
           role = c("aut", "cre")),
    person("Xiaotao", "Shen",
           email = "xiaotao.shen@ntu.edu.sg",
           role = c("aut", "cph"))
